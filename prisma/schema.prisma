// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPER_ADMIN
  USER
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_PASSWORD
  CHANGE_EMAIL
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  avatar       String?
  isActive     Boolean  @default(true)
  lastSeen     DateTime?

  // Untuk batas ganti password / email seminggu sekali.
  passwordChangedAt DateTime?
  emailChangedAt    DateTime?

  sessions     Session[]
  otpCodes     OtpCode[]
  activityLogs ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id        String     @id @default(uuid())
  purpose   OtpPurpose
  email     String
  codeHash  String
  payload   Json?
  attempts  Int        @default(0)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String?
  targetId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}